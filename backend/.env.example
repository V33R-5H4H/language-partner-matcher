# ============================================================
# Language Partner Matcher — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# ============================================================

# --- Project ---
PROJECT_NAME="Language Partner Matcher"
API_V1_STR="/api/v1"
ENVIRONMENT="development"   # development | production

# --- Database (PostgreSQL) ---
# Local Docker Compose:  postgresql+asyncpg://postgres:postgres@postgres_db:5432/langmatcher
# AWS RDS:               postgresql+asyncpg://<user>:<password>@<rds-host>:5432/<db-name>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/langmatcher"

# --- Redis ---
# Local Docker Compose:  redis://redis_cache:6379/0
# Dedicated Redis EC2:   redis://<PRIVATE_IP>:6379/0
# With password:         redis://:<password>@<PRIVATE_IP>:6379/0
REDIS_URL="redis://localhost:6379/0"

# --- JWT Authentication ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="CHANGE_ME_generate_a_strong_random_secret_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# --- WebRTC / CoTURN ---
# Public-facing domain or IP of your standalone CoTURN server
TURN_DOMAIN="turn.yourdomain.com"
# Public Elastic IP of CoTURN EC2 (used in external-ip config)
TURN_SERVER_IP="YOUR_COTURN_PUBLIC_IP"
# Shared HMAC-SHA1 secret between backend and CoTURN (must match turnserver.conf)
# Generate: openssl rand -hex 32
TURN_SHARED_SECRET="CHANGE_ME_generate_a_strong_turn_secret_here"
TURN_PORT_UDP=3478
TURN_PORT_TLS=5349
